# Firebase web configuration (existing project: baeeyen-c7107)
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyAtnPXcLjEjT1yw0mpO2qw_6_pYHQsUZeA
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=baeeyen-c7107.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=baeeyen-c7107
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=baeeyen-c7107.firebasestorage.app
NEXT_PUBLIC_FIREBASE_APP_ID=1:289802927952:web:deda8750a6bb6d4ce7b655

# Firestore data namespace: artifacts/{NEXT_PUBLIC_DATA_APP_ID}/public/data/...
# Legacy app used `typeof __app_id !== 'undefined' ? __app_id : 'default-app-id'`,
# so existing data lives under "default-app-id". Keep unless you migrate.
NEXT_PUBLIC_DATA_APP_ID=default-app-id

# Demo OTP accepted by the demo verification service (the UI shows this to users).
NEXT_PUBLIC_DEMO_OTP=123456

# Optional: set to "true" to render the demo-only "بدء جلسة تجريبية جديدة"
# control on the home screen (signs the anonymous demo user out and reloads so
# a fresh anonymous UID is created). Never enable this in production.
NEXT_PUBLIC_DEMO_SESSION_RESET=

# Registration always creates the account with status "pending" from the
# browser (Firestore rules enforce this). Approval is privileged and requires
# the admin portal plus a configured Firebase Admin SDK below.

# Server-side admin portal password (validated ONLY in Route Handlers, never in the browser).
ADMIN_PASSWORD=1234

# Optional: secret used to sign the admin session cookie.
# When empty, a key derived from ADMIN_PASSWORD is used (fine for local/demo).
ADMIN_SESSION_SECRET=

# Optional: JSON string of a Firebase service account for the Admin SDK
# (used by /api/admin/* route handlers and scripts/migrate-messages.ts).
# Registration does NOT need it — it writes from the browser and always starts
# as "pending"; only the admin approval portal requires these credentials.
# GOOGLE_APPLICATION_CREDENTIALS is also honored via ADC.
FIREBASE_SERVICE_ACCOUNT=
