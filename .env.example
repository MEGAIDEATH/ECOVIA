# ==========================================================================
# ECOVIA environment variables
# Copy this file to .env.local and configure real values.
# ==========================================================================

# Database connection (PostgreSQL / Neon compatible)
# Local development (docker-compose publishes host port 5433 -> container 5432).
# Production: paste the company-owned Neon connection string here instead.
# This is a SERVER-ONLY secret. Never prefix it with NEXT_PUBLIC_.
DATABASE_URL=postgres://ecovia:ecovia_dev_password@localhost:5433/ecovia_dev
# Neon: `neon env pull` writes DATABASE_URL (pooled, used by the app) and
# DATABASE_URL_UNPOOLED (direct, used by migrations/seed/drizzle-kit).
# Leave unset locally; scripts fall back to DATABASE_URL.
DATABASE_URL_UNPOOLED=

# Better Auth configuration.
# Generate a strong secret for production: openssl rand -base64 48
BETTER_AUTH_SECRET=development-secret-change-in-production-min-32-chars
BETTER_AUTH_URL=http://localhost:3000

# Administrator account created by `npm run db:seed` (role is stored in the
# database, never trusted from the browser).
ADMIN_EMAIL=admin@ecovia.local
ADMIN_PASSWORD=admin_secure_password_123

# --------------------------------------------------------------------------
# One-time codes (SERVER-ONLY — never prefix these with NEXT_PUBLIC_)
# No SMS/email provider is configured yet. Behaviour:
#   * Local dev (npm run dev): demo mode is on for every identity, code below.
#   * Any deployment: real mode unless OTP_MODE=demo AND OTP_DEMO_CODE AND an
#     explicit OTP_DEMO_ALLOWLIST are set ("*" is rejected on deployments).
#   * Vercel Production additionally needs OTP_DEMO_ALLOW_PRODUCTION=true —
#     only with an isolated demo database.
# Demo identities: specialist phone numbers as typed in the form, and
# organizations as org_<CR number>@ecovia.local. Comma-separated.
# --------------------------------------------------------------------------
OTP_MODE=
OTP_DEMO_CODE=
OTP_DEMO_ALLOWLIST=
OTP_DEMO_ALLOW_PRODUCTION=
# Legacy local fallback for the demo code (used only when OTP_DEMO_CODE is unset).
DEV_OTP_CODE=123456

# Optional: set to "true" to render the demo session reset control
NEXT_PUBLIC_DEMO_SESSION_RESET=true

# Protected documents storage directory (defaults to .data/uploads)
STORAGE_LOCAL_DIR=
