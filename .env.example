# ==========================================================================
# ECOVIA environment variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local, .env, or any service-account JSON.
# ==========================================================================

# ---------------------------------------------------------------------------
# CLIENT-VISIBLE (NEXT_PUBLIC_* is inlined into the browser bundle by Next.js.
# Firebase web config is public by design — security comes from Firestore /
# Storage rules, not from hiding these values.)
# ---------------------------------------------------------------------------

# Firebase Web app configuration of the NEW project
# (Firebase Console > Project settings > Your apps > SDK setup and configuration).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=<new-project-id>.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firestore/Storage logical namespace: artifacts/{NEXT_PUBLIC_DATA_APP_ID}/public/data/...
# The legacy app used `typeof __app_id !== 'undefined' ? __app_id : 'default-app-id'`,
# so the data model expects "default-app-id". KEEP this value when switching
# Firebase projects — the Firebase project ID and the data app ID are separate
# concepts. Rules and indexes are written against this namespace.
NEXT_PUBLIC_DATA_APP_ID=default-app-id

# Demo OTP accepted by the demo verification service (the UI shows it to users).
NEXT_PUBLIC_DEMO_OTP=123456

# Optional: set to "true" to render the demo-only "بدء جلسة تجريبية جديدة"
# control on the home screen (signs the anonymous demo user out and reloads so a
# fresh anonymous UID is created — local session only, never deletes data).
# Leave empty in production; without the flag the control is not rendered.
NEXT_PUBLIC_DEMO_SESSION_RESET=

# ---------------------------------------------------------------------------
# SERVER-ONLY (read exclusively by Route Handlers / server code / scripts.
# Configure these in your shell or in the Netlify environment UI.
# NEVER prefix them with NEXT_PUBLIC_ — never expose them to the browser.)
# ---------------------------------------------------------------------------

# Admin portal password (validated ONLY in Route Handlers, never in the browser).
ADMIN_PASSWORD=

# Optional: secret used to sign the admin session cookie.
# When empty, a key derived from ADMIN_PASSWORD is used (fine for local/demo).
ADMIN_SESSION_SECRET=

# JSON string of a Firebase service-account key for the Admin SDK (used by
# /api/admin/* route handlers and scripts/migrate-messages.ts).
# Registration does NOT need it — the browser writes "pending" documents
# directly; only the admin approval portal requires these credentials.
# On Netlify: set as a server-side environment variable (single line JSON).
# NEVER commit a service-account JSON file and NEVER use
# NEXT_PUBLIC_FIREBASE_SERVICE_ACCOUNT.
FIREBASE_SERVICE_ACCOUNT=

# Alternative to FIREBASE_SERVICE_ACCOUNT: absolute path to a service-account
# JSON file for local development only (Netlify has no access to your filesystem,
# so do not use this variable there).
GOOGLE_APPLICATION_CREDENTIALS=

# Local Firestore emulator (used by `npm run test:rules`). Leave unset otherwise.
# FIRESTORE_EMULATOR_HOST=

