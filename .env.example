# ==========================================================================
# ECOVIA environment variables
# Copy this file to .env.local and configure real values.
# ==========================================================================

# Database connection (PostgreSQL / Neon compatible)
# Local development (docker-compose publishes host port 5433 -> container 5432).
# Production: paste the company-owned Neon connection string here instead.
# This is a SERVER-ONLY secret. Never prefix it with NEXT_PUBLIC_.
DATABASE_URL=postgres://ecovia:ecovia_dev_password@localhost:5433/ecovia_dev

# Better Auth configuration.
# Generate a strong secret for production: openssl rand -base64 48
BETTER_AUTH_SECRET=development-secret-change-in-production-min-32-chars
BETTER_AUTH_URL=http://localhost:3000

# Administrator account created by `npm run db:seed` (role is stored in the
# database, never trusted from the browser).
ADMIN_EMAIL=admin@ecovia.local
ADMIN_PASSWORD=admin_secure_password_123

# Development OTP code (only accepted when NODE_ENV !== 'production',
# or when NEXT_PUBLIC_ALLOW_DEV_OTP=true — used by the local E2E run)
DEV_OTP_CODE=123456

# Optional: set to "true" to render the demo session reset control
NEXT_PUBLIC_DEMO_SESSION_RESET=true

# Protected documents storage directory (defaults to .data/uploads)
STORAGE_LOCAL_DIR=
